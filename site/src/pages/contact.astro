---
import Base from '../layouts/Base.astro';
---

<Base
  title="Contact — VibeStats"
  description="Contact the VibeStats open-source project maintainers."
>
  <main class="docs-content max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <h1>Contact</h1>
    <p>VibeStats is an open-source project maintained through GitHub.</p>
    <p>
      For support, questions, or general feedback, <a
        href="https://github.com/stephenleo/vibestats/issues/new"
        target="_blank"
        rel="noopener noreferrer">open a GitHub issue</a
      >. For vulnerabilities, follow the <a href="/security">security reporting instructions</a>.
    </p>
  </main>
</Base>
